generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  CONFIRMED
}

model Order {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId        String
  idempotencyKey String      @unique
  status         OrderStatus @default(PENDING)
  passengerId    String      @unique @db.Uuid
  passenger      Passenger   @relation(fields: [passengerId], references: [id], onDelete: Restrict)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// FK fica em Order (passengerId), não em Passenger: apagar um Passenger enquanto algum Order o
// referencia é rejeitado (onDelete: Restrict) — precisa apagar o Order primeiro.
model Passenger {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  document  String
  order     Order?
  createdAt DateTime @default(now())
}
